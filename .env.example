# Copier ce fichier en .env.local (jamais commité) et remplir avec les valeurs
# du dashboard EmailJS (https://dashboard.emailjs.com/) : Account > General pour
# la Public Key, Email Services pour le Service ID, Email Templates pour le
# Template ID. Voir README pour la marche à suivre complète.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Cloudinary (https://cloudinary.com/, forfait gratuit sans carte bancaire) :
# stocke le fichier de gravure envoyé par le client et le PDF récapitulatif
# de commande. Créer un compte, récupérer le "Cloud name" sur le tableau de
# bord, puis créer un upload preset en mode "Unsigned" dans
# Settings > Upload > Upload presets > Add upload preset.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
